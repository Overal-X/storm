{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storm Workflow Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the workflow."
    },
    "on": {
      "type": "object",
      "properties": {
        "push": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "directory": {
      "type": "string",
      "description": "Directory to run the workflow from"
    },
    "defaults": {
      "type": "object",
      "description": "Global fallbacks applied to every job step unless the step overrides them.",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Directory to run steps from. Overrides the workflow-level directory; overridden by a step's own directory."
        },
        "shell": {
          "type": "string",
          "description": "Shell to run steps with. Overridden by a step's own shell."
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the job."
          },
          "runs-on": {
            "type": "string",
            "description": "The environments where the job should run."
          },
          "needs": {
            "type": "string",
            "description": "The job that must complete before this job starts."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the step."
                },
                "run": {
                  "type": "string",
                  "description": "The command to run in this step."
                },
                "shell": {
                  "type": "string",
                  "description": "The shell to use for command execution."
                },
                "directory": {
                  "type": "string",
                  "description": "Directory to run the workflow from"
                }
              },
              "required": ["name", "run"]
            }
          }
        },
        "required": ["name", "steps"]
      }
    }
  },
  "required": ["name", "jobs"]
}
